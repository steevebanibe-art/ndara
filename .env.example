# NDARA — configuration. Copier en .env, remplir, exporter.
#
#   bash / Git Bash : set -a && source .env && set +a
#   PowerShell      : Get-Content .env | % { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#
# ⚠️ NE JAMAIS VERSIONNER LE FICHIER .env NI COLLER UNE CLÉ DANS UNE CONVERSATION.
# Tout fonctionne sans aucune de ces clés : le moteur bascule alors en saisie
# clavier et l'interface l'annonce explicitement.

# --- Sel de pseudonymisation -------------------------------------------------
# Sert à hacher les numéros de téléphone (HMAC-SHA256). Le changer rend
# incomparables les vagues passées et futures : à fixer UNE FOIS, puis à
# sauvegarder hors du dépôt.
NDARA_SALT=

# --- Codage des réponses (facultatif) ----------------------------------------
# Sans clé, le codage déterministe suffit et reste auditable ligne à ligne.
ANTHROPIC_API_KEY=
NDARA_LLM_MODEL=claude-sonnet-5

# --- Transcription (facultatif) ----------------------------------------------
# ElevenLabs Scribe prend en charge le khmer (précision modérée : 20–50 % de
# taux d'erreur mot — d'où le repli clavier prévu dans le questionnaire).
ELEVENLABS_API_KEY=

# --- Azure Speech : synthèse ET reconnaissance -------------------------------
# Voix khmères vérifiées : km-KH-SreymomNeural, km-KH-PisethNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Téléphonie (à ouvrir au moment des appels réels) ------------------------
# Ordre de grandeur : ~0,55 $/min vers un mobile camerounais.
# Vérifier dans la console si un numéro local est disponible : un identifiant
# d'appelant étranger fait chuter le taux de décrochage, donc la qualité.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# URL publique du serveur, indispensable pour les rappels TwiML.
# En développement : un tunnel (ngrok, cloudflared) vers le port 8000.
NDARA_PUBLIC_URL=
